// connection.grav — one connection to a Redis server: the raw command (the
// escape hatch everything else is built on), pipelining, transactions,
// pub/sub, and typed convenience methods for the commands most programs use.
//
//   let r = Redis.open("redis://localhost:6379/0")
//   r.set("name", "Ada")
//   r.get("name")                              // "Ada"
//   r.expire("name", 60)
//   r.command("OBJECT", ["ENCODING", "name"])  // anything not wrapped below
import "std"
import "std/net"
import "resp.grav"

namespace redis {

    // How to reach a server: parsed from a URL (see RedisConnection.parseUrl),
    // or built by hand.
    class RedisOptions {
        public host: string = "127.0.0.1"
        public port: int = 6379
        // "" for no AUTH.
        public password: string = ""
        // "" for no per-connection username (Redis 6+ ACLs); AUTH user pass.
        public username: string = ""
        public database: int = 0
        public tls: bool = false
        public connectTimeoutMs: int = 5000
        // Reads and writes after connecting; 0 waits forever.
        public timeoutMs: int = 0
    }

    // One TCP connection to a Redis server, and the protocol state (a MULTI in
    // progress, an active subscription) that belongs to it alone.
    class RedisConnection {
        private conn: TcpStream
        private closed: bool = false
        public options: RedisOptions

        constructor(options: RedisOptions) {
            self.options = options;
            self.conn = options.tls ? Tls.connect(options.host, options.port, TlsContext.client(), options.connectTimeoutMs)
                                    : TcpStream.connect(options.host, options.port, options.connectTimeoutMs);
            if (options.timeoutMs > 0) { self.conn.setTimeoutMs(options.timeoutMs); }
            self.conn.setNoDelay(true);
            if (options.username != "") { self.command("AUTH", [options.username, options.password]); }
            else if (options.password != "") { self.command("AUTH", [options.password]); }
            if (options.database != 0) { self.command("SELECT", [options.database]); }
        }
        destructor() { self.close(); }

        // "redis://[[user]:password@]host[:port][/database][?timeout=ms]", or
        // "rediss://..." for TLS. Host, port and database all have defaults.
        static fn open(url: string) -> RedisConnection { return new RedisConnection(RedisConnection.parseUrl(url)); }
        static fn parseUrl(url: string) -> RedisOptions {
            let sep = Str.indexOf(url, "://");
            let scheme = sep < 0 ? "" : Str.lower(url[..sep]);
            if (scheme != "redis" && scheme != "rediss") {
                throw new ValueError("not a Redis URL (redis://[:password@]host:port/database): " + url);
            }
            let o = new RedisOptions();
            o.tls = scheme == "rediss";
            let rest = url[sep + 3..];
            let q = Str.indexOf(rest, "?");
            let query = "";
            if (q >= 0) { query = rest[q + 1..]; rest = rest[..q]; }
            let slash = Str.indexOf(rest, "/");
            let authority = slash >= 0 ? rest[..slash] : rest;
            if (slash >= 0 && rest[slash + 1..] != "") { o.database = Integer.parseOr(rest[slash + 1..], 0) as int; }
            let at = Str.lastIndexOf(authority, "@");
            if (at >= 0) {
                let info = authority[..at];
                authority = authority[at + 1..];
                let colon = Str.indexOf(info, ":");
                if (colon >= 0) { o.username = Url.decode(info[..colon]); o.password = Url.decode(info[colon + 1..]); }
                else { o.password = Url.decode(info); }        // redis://:password@host (no user)
            }
            let close = Str.lastIndexOf(authority, "]");
            let colon = Str.lastIndexOf(authority, ":");
            if (colon > close) {
                o.port = Format.toIntOr(authority[colon + 1..], -1) as int;
                if (o.port <= 0 || o.port > 65535) { throw new ValueError("bad port in Redis URL: " + url); }
                authority = authority[..colon];
            }
            if (Str.startsWith(authority, "[") && Str.endsWith(authority, "]")) { authority = authority[1..authority.length - 1]; }
            if (authority != "") { o.host = authority; }
            for (pair in Str.split(query, "&")) {
                if (pair == "") { continue; }
                let eq = Str.indexOf(pair, "=");
                let key = eq >= 0 ? pair[..eq] : pair;
                let value = eq >= 0 ? Url.decode(pair[eq + 1..]) : "";
                switch (key) {
                    case "timeout": o.timeoutMs = Format.toIntOr(value, o.timeoutMs) as int
                    case "connectTimeout": o.connectTimeoutMs = Format.toIntOr(value, o.connectTimeoutMs) as int
                    default: throw new ValueError("unknown Redis URL option '" + key + "' (timeout, connectTimeout): " + url)
                }
            }
            return o;
        }

        fn close() { if (!self.closed) { self.closed = true; self.conn.close(); } }
        fn isOpen() -> bool { return !self.closed && !self.conn.isClosed(); }
        fn driver() -> string { return "redis"; }

        // ── the raw command (everything else is built on this) ──────────────────
        // Sends `name` with `args` (each turned into its text form, with no copy for
        // a string already one), and reads the one reply: a string, a long, null,
        // or an Array<any> (nested arrays included); RedisError for a `-ERR ...` one.
        fn command(name: string, args: Array<any> = new Array<any>()) -> any {
            Resp.writeCommand(self.conn, name, args);
            return Resp.readReply(self.conn);
        }

        // ── pipelining: every command queued, then every reply read at once ──────
        // `f` queues commands on `p`; their replies come back in the same order,
        // after one round trip instead of one per command.
        fn pipeline(f: fn(RedisPipeline)) -> Array<any> {
            let p = new RedisPipeline(self.conn);
            f(p);
            return p.flush();
        }

        // ── transactions (MULTI/EXEC) ─────────────────────────────────────────────
        // Queues commands (each answered "QUEUED", not run) until exec() runs them
        // all atomically, or discard() drops them. watch(keys) before multi() aborts
        // the transaction (exec() gives null) if any of them changed first.
        fn watch(keys: Array<string>) { let a = new Array<any>(); for (k in keys) { a.push(k); } self.command("WATCH", a); }
        fn unwatch() { self.command("UNWATCH"); }
        fn multi() -> RedisTransaction {
            self.command("MULTI");
            return new RedisTransaction(self);
        }
        // Runs `f(tx)` as a MULTI/EXEC, retrying from watch() when a watched key
        // changed first (exec() gave null): `attempts` times, then StateError.
        fn transaction(watch: Array<string>, f: fn(RedisTransaction), attempts: int = 3) -> Array<any> {
            for (i in 0..attempts) {
                if (watch.size() > 0) { self.watch(watch); }
                let tx = self.multi();
                f(tx);
                let result = tx.exec();
                if (result != null) { return result as Array<any>; }
            }
            throw new StateError("the transaction's watched keys kept changing (${attempts} attempts)");
        }

        // ── pub/sub ───────────────────────────────────────────────────────────────
        // The number of subscribers that received it.
        fn publish(channel: string, message: string) -> long { return RedisConnection.toLong(self.command("PUBLISH", [channel, message]), 0); }
        // Subscribes to `channels` and calls `onMessage(channel, payload)` for each
        // one published, forever (until unsubscribed from elsewhere, or the
        // connection closes) — this call does not return. Give this connection to
        // nothing else: while subscribed, it can only read pub/sub frames.
        fn subscribe(channels: Array<string>, onMessage: fn(string, string)) {
            let cmd = new Array<any>();
            for (c in channels) { cmd.push(c); }
            self.command("SUBSCRIBE", cmd);                      // reads the first channel's own confirmation
            for (i in 1..channels.size()) { Resp.readReply(self.conn); }   // the rest of them
            while (true) {
                let frame = Resp.readReply(self.conn) as Array<any>;
                if (frame.size() >= 3 && "${frame[0]}" == "message") { onMessage("${frame[1]}", "${frame[2]}"); }
            }
        }
        // Subscribes to channels matching `patterns` (glob-style: "news.*").
        fn psubscribe(patterns: Array<string>, onMessage: fn(string, string, string)) {
            let cmd = new Array<any>();
            for (p in patterns) { cmd.push(p); }
            self.command("PSUBSCRIBE", cmd);                     // reads the first pattern's own confirmation
            for (i in 1..patterns.size()) { Resp.readReply(self.conn); }   // the rest of them
            while (true) {
                let frame = Resp.readReply(self.conn) as Array<any>;
                if (frame.size() >= 4 && "${frame[0]}" == "pmessage") { onMessage("${frame[1]}", "${frame[2]}", "${frame[3]}"); }
            }
        }

        // ── scripting ─────────────────────────────────────────────────────────────
        fn eval(script: string, keys: Array<string>, args: Array<any> = new Array<any>()) -> any {
            let a = new Array<any>();
            a.push(script);
            a.push(keys.size());
            for (k in keys) { a.push(k); }
            for (x in args) { a.push(x); }
            return self.command("EVAL", a);
        }
        fn evalSha(sha: string, keys: Array<string>, args: Array<any> = new Array<any>()) -> any {
            let a = new Array<any>();
            a.push(sha);
            a.push(keys.size());
            for (k in keys) { a.push(k); }
            for (x in args) { a.push(x); }
            return self.command("EVALSHA", a);
        }
        // Loads a script once; its SHA1, to run with evalSha (avoids resending it).
        fn scriptLoad(script: string) -> string { return "${self.command("SCRIPT", ["LOAD", script])}"; }

        // ── generic ───────────────────────────────────────────────────────────────
        fn ping() -> string { return "${self.command("PING")}"; }
        fn echo(message: string) -> string { return "${self.command("ECHO", [message])}"; }
        fn select(db: int) { self.command("SELECT", [db]); }
        fn dbSize() -> long { return RedisConnection.toLong(self.command("DBSIZE"), 0); }
        // Deletes every key of the current database. Of every database: flushAll().
        fn flushDb() { self.command("FLUSHDB"); }
        fn flushAll() { self.command("FLUSHALL"); }

        // ── keys ──────────────────────────────────────────────────────────────────
        fn del(keys: Array<string>) -> long { let a = new Array<any>(); for (k in keys) { a.push(k); } return RedisConnection.toLong(self.command("DEL", a), 0); }
        fn del(key: string) -> long { let a = new Array<string>(); a.push(key); return self.del(a); }
        fn exists(keys: Array<string>) -> long { let a = new Array<any>(); for (k in keys) { a.push(k); } return RedisConnection.toLong(self.command("EXISTS", a), 0); }
        fn exists(key: string) -> bool { return self.exists1(key) > 0; }
        private fn exists1(key: string) -> long { let a = new Array<string>(); a.push(key); return self.exists(a); }
        fn expire(key: string, seconds: long) -> bool { return self.command("EXPIRE", [key, seconds]) == 1; }
        fn pExpire(key: string, millis: long) -> bool { return self.command("PEXPIRE", [key, millis]) == 1; }
        fn expireAt(key: string, unixSeconds: long) -> bool { return self.command("EXPIREAT", [key, unixSeconds]) == 1; }
        fn persist(key: string) -> bool { return self.command("PERSIST", [key]) == 1; }
        // Seconds left, -1 for no expiry, -2 for no such key.
        fn ttl(key: string) -> long { return RedisConnection.toLong(self.command("TTL", [key]), -2); }
        fn pTtl(key: string) -> long { return RedisConnection.toLong(self.command("PTTL", [key]), -2); }
        // "string", "list", "set", "zset", "hash", "stream" or "none" (no such key).
        fn keyType(key: string) -> string { return "${self.command("TYPE", [key])}"; }
        fn keys(pattern: string) -> Array<string> { return RedisConnection.strings(self.command("KEYS", [pattern]) as Array<any>); }
        // One step of a KEYS scan that does not block the server: the next cursor
        // (0 when done) and this step's keys; start with cursor 0.
        fn scan(cursor: long, pattern: string = "*", count: int = 100) -> Pair<long, Array<string>> {
            let r = self.command("SCAN", [cursor, "MATCH", pattern, "COUNT", count]) as Array<any>;
            return new Pair<long, Array<string>>(RedisConnection.toLong(r[0], 0), RedisConnection.strings(r[1] as Array<any>));
        }
        fn rename(key: string, newKey: string) { self.command("RENAME", [key, newKey]); }
        fn renameNx(key: string, newKey: string) -> bool { return self.command("RENAMENX", [key, newKey]) == 1; }
        fn randomKey() -> string { return RedisConnection.orEmpty(self.command("RANDOMKEY")); }
        fn copy(source: string, destination: string, replace: bool = false) -> bool {
            let a = new Array<any>(); a.push(source); a.push(destination);
            if (replace) { a.push("REPLACE"); }
            return self.command("COPY", a) == 1;
        }

        // ── strings ───────────────────────────────────────────────────────────────
        fn get(key: string) -> string? { return RedisConnection.orNull(self.command("GET", [key])); }
        // Sets it; with a TTL (ex: seconds, px: milliseconds, 0 for none), and
        // nx/xx (only if it does not/does exist); false when nx/xx stopped it.
        fn set(key: string, value: any, ex: long = 0, px: long = 0, nx: bool = false, xx: bool = false) -> bool {
            let a = new Array<any>(); a.push(key); a.push(value);
            if (ex > 0) { a.push("EX"); a.push(ex); }
            if (px > 0) { a.push("PX"); a.push(px); }
            if (nx) { a.push("NX"); }
            if (xx) { a.push("XX"); }
            return self.command("SET", a) != null;
        }
        fn setEx(key: string, seconds: long, value: any) { self.command("SETEX", [key, seconds, value]); }
        fn pSetEx(key: string, millis: long, value: any) { self.command("PSETEX", [key, millis, value]); }
        fn setNx(key: string, value: any) -> bool { return self.command("SETNX", [key, value]) == 1; }
        // The old value (null if none), after setting the new one.
        fn getSet(key: string, value: any) -> string? { return RedisConnection.orNull(self.command("GETSET", [key, value])); }
        // GETDEL: the value, removing the key.
        fn getDel(key: string) -> string? { return RedisConnection.orNull(self.command("GETDEL", [key])); }
        fn append(key: string, value: string) -> long { return RedisConnection.toLong(self.command("APPEND", [key, value]), 0); }
        fn strLen(key: string) -> long { return RedisConnection.toLong(self.command("STRLEN", [key]), 0); }
        fn incr(key: string) -> long { return RedisConnection.toLong(self.command("INCR", [key]), 0); }
        fn decr(key: string) -> long { return RedisConnection.toLong(self.command("DECR", [key]), 0); }
        fn incrBy(key: string, by: long) -> long { return RedisConnection.toLong(self.command("INCRBY", [key, by]), 0); }
        fn decrBy(key: string, by: long) -> long { return RedisConnection.toLong(self.command("DECRBY", [key, by]), 0); }
        fn incrByFloat(key: string, by: double) -> double { return Format.toFloatOr("${self.command("INCRBYFLOAT", [key, by])}", 0.0); }
        // The matching keys' values, in order; a missing key's slot is null.
        fn mGet(keys: Array<string>) -> Array<string?> {
            let a = new Array<any>(); for (k in keys) { a.push(k); }
            let r = self.command("MGET", a) as Array<any>;
            let out = new Array<string?>();
            for (x in r) { out.push(x == null ? null : "${x}"); }
            return out;
        }
        fn mSet(values: HashMap<string, any>) {
            let a = new Array<any>();
            for (k in values.keys()) { a.push(k); a.push(values[k]); }
            self.command("MSET", a);
        }
        fn setBit(key: string, offset: long, value: int) -> long { return RedisConnection.toLong(self.command("SETBIT", [key, offset, value]), 0); }
        fn getBit(key: string, offset: long) -> long { return RedisConnection.toLong(self.command("GETBIT", [key, offset]), 0); }
        fn bitCount(key: string) -> long { return RedisConnection.toLong(self.command("BITCOUNT", [key]), 0); }

        // ── hashes ────────────────────────────────────────────────────────────────
        fn hGet(key: string, field: string) -> string? { return RedisConnection.orNull(self.command("HGET", [key, field])); }
        fn hSet(key: string, field: string, value: any) -> long { return RedisConnection.toLong(self.command("HSET", [key, field, value]), 0); }
        fn hSet(key: string, values: HashMap<string, any>) -> long {
            let a = new Array<any>(); a.push(key);
            for (k in values.keys()) { a.push(k); a.push(values[k]); }
            return RedisConnection.toLong(self.command("HSET", a), 0);
        }
        fn hSetNx(key: string, field: string, value: any) -> bool { return self.command("HSETNX", [key, field, value]) == 1; }
        fn hDel(key: string, fields: Array<string>) -> long { let a = new Array<any>(); a.push(key); for (f in fields) { a.push(f); } return RedisConnection.toLong(self.command("HDEL", a), 0); }
        fn hExists(key: string, field: string) -> bool { return self.command("HEXISTS", [key, field]) == 1; }
        fn hGetAll(key: string) -> HashMap<string, string> {
            let r = self.command("HGETALL", [key]) as Array<any>;
            let out = new HashMap<string, string>();
            for (i in 0..(r.size() / 2)) { out.put("${r[i * 2]}", "${r[i * 2 + 1]}"); }
            return out;
        }
        fn hKeys(key: string) -> Array<string> { return RedisConnection.strings(self.command("HKEYS", [key]) as Array<any>); }
        fn hVals(key: string) -> Array<string> { return RedisConnection.strings(self.command("HVALS", [key]) as Array<any>); }
        fn hLen(key: string) -> long { return RedisConnection.toLong(self.command("HLEN", [key]), 0); }
        fn hIncrBy(key: string, field: string, by: long) -> long { return RedisConnection.toLong(self.command("HINCRBY", [key, field, by]), 0); }
        fn hIncrByFloat(key: string, field: string, by: double) -> double { return Format.toFloatOr("${self.command("HINCRBYFLOAT", [key, field, by])}", 0.0); }
        // The matching fields' values, in order; a missing field's slot is null.
        fn hMGet(key: string, fields: Array<string>) -> Array<string?> {
            let a = new Array<any>(); a.push(key); for (f in fields) { a.push(f); }
            let r = self.command("HMGET", a) as Array<any>;
            let out = new Array<string?>();
            for (x in r) { out.push(x == null ? null : "${x}"); }
            return out;
        }

        // ── lists ─────────────────────────────────────────────────────────────────
        fn lPush(key: string, values: Array<any>) -> long { let a = new Array<any>(); a.push(key); for (v in values) { a.push(v); } return RedisConnection.toLong(self.command("LPUSH", a), 0); }
        fn lPush(key: string, value: any) -> long { let a = new Array<any>(); a.push(value); return self.lPush(key, a); }
        fn rPush(key: string, values: Array<any>) -> long { let a = new Array<any>(); a.push(key); for (v in values) { a.push(v); } return RedisConnection.toLong(self.command("RPUSH", a), 0); }
        fn rPush(key: string, value: any) -> long { let a = new Array<any>(); a.push(value); return self.rPush(key, a); }
        fn lPop(key: string) -> string? { return RedisConnection.orNull(self.command("LPOP", [key])); }
        fn rPop(key: string) -> string? { return RedisConnection.orNull(self.command("RPOP", [key])); }
        fn lRange(key: string, start: long, stop: long) -> Array<string> { return RedisConnection.strings(self.command("LRANGE", [key, start, stop]) as Array<any>); }
        fn lLen(key: string) -> long { return RedisConnection.toLong(self.command("LLEN", [key]), 0); }
        fn lIndex(key: string, index: long) -> string? { return RedisConnection.orNull(self.command("LINDEX", [key, index])); }
        fn lSet(key: string, index: long, value: any) { self.command("LSET", [key, index, value]); }
        fn lRem(key: string, count: long, value: any) -> long { return RedisConnection.toLong(self.command("LREM", [key, count, value]), 0); }
        fn lTrim(key: string, start: long, stop: long) { self.command("LTRIM", [key, start, stop]); }
        fn lInsertBefore(key: string, pivot: any, value: any) -> long { return RedisConnection.toLong(self.command("LINSERT", [key, "BEFORE", pivot, value]), 0); }
        fn lInsertAfter(key: string, pivot: any, value: any) -> long { return RedisConnection.toLong(self.command("LINSERT", [key, "AFTER", pivot, value]), 0); }
        fn rPopLPush(source: string, destination: string) -> string? { return RedisConnection.orNull(self.command("RPOPLPUSH", [source, destination])); }
        // Waits up to `timeoutSeconds` (0: forever) for an item; [key, value], or null.
        fn blPop(keys: Array<string>, timeoutSeconds: long) -> Array<string> {
            let a = new Array<any>(); for (k in keys) { a.push(k); } a.push(timeoutSeconds);
            let r = self.command("BLPOP", a);
            return r == null ? null : RedisConnection.strings(r as Array<any>);
        }
        fn brPop(keys: Array<string>, timeoutSeconds: long) -> Array<string> {
            let a = new Array<any>(); for (k in keys) { a.push(k); } a.push(timeoutSeconds);
            let r = self.command("BRPOP", a);
            return r == null ? null : RedisConnection.strings(r as Array<any>);
        }

        // ── sets ──────────────────────────────────────────────────────────────────
        fn sAdd(key: string, members: Array<any>) -> long { let a = new Array<any>(); a.push(key); for (m in members) { a.push(m); } return RedisConnection.toLong(self.command("SADD", a), 0); }
        fn sAdd(key: string, member: any) -> long { let a = new Array<any>(); a.push(member); return self.sAdd(key, a); }
        fn sRem(key: string, members: Array<any>) -> long { let a = new Array<any>(); a.push(key); for (m in members) { a.push(m); } return RedisConnection.toLong(self.command("SREM", a), 0); }
        fn sMembers(key: string) -> Array<string> { return RedisConnection.strings(self.command("SMEMBERS", [key]) as Array<any>); }
        fn sIsMember(key: string, member: any) -> bool { return self.command("SISMEMBER", [key, member]) == 1; }
        fn sCard(key: string) -> long { return RedisConnection.toLong(self.command("SCARD", [key]), 0); }
        fn sPop(key: string) -> string? { return RedisConnection.orNull(self.command("SPOP", [key])); }
        fn sRandMember(key: string) -> string? { return RedisConnection.orNull(self.command("SRANDMEMBER", [key])); }
        fn sUnion(keys: Array<string>) -> Array<string> { let a = new Array<any>(); for (k in keys) { a.push(k); } return RedisConnection.strings(self.command("SUNION", a) as Array<any>); }
        fn sInter(keys: Array<string>) -> Array<string> { let a = new Array<any>(); for (k in keys) { a.push(k); } return RedisConnection.strings(self.command("SINTER", a) as Array<any>); }
        fn sDiff(keys: Array<string>) -> Array<string> { let a = new Array<any>(); for (k in keys) { a.push(k); } return RedisConnection.strings(self.command("SDIFF", a) as Array<any>); }
        fn sMove(source: string, destination: string, member: any) -> bool { return self.command("SMOVE", [source, destination, member]) == 1; }

        // ── sorted sets ───────────────────────────────────────────────────────────
        fn zAdd(key: string, score: double, member: any) -> long { return RedisConnection.toLong(self.command("ZADD", [key, score, member]), 0); }
        fn zAdd(key: string, scored: HashMap<string, double>) -> long {
            let a = new Array<any>(); a.push(key);
            for (m in scored.keys()) { a.push(scored[m]); a.push(m); }
            return RedisConnection.toLong(self.command("ZADD", a), 0);
        }
        fn zRem(key: string, members: Array<any>) -> long { let a = new Array<any>(); a.push(key); for (m in members) { a.push(m); } return RedisConnection.toLong(self.command("ZREM", a), 0); }
        fn zScore(key: string, member: any) -> double { let r = self.command("ZSCORE", [key, member]); return r == null ? 0.0 : Format.toFloatOr("${r}", 0.0); }
        fn zIncrBy(key: string, by: double, member: any) -> double { return Format.toFloatOr("${self.command("ZINCRBY", [key, by, member])}", 0.0); }
        fn zCard(key: string) -> long { return RedisConnection.toLong(self.command("ZCARD", [key]), 0); }
        fn zCount(key: string, min: double, max: double) -> long { return RedisConnection.toLong(self.command("ZCOUNT", [key, min, max]), 0); }
        fn zRank(key: string, member: any) -> long { let r = self.command("ZRANK", [key, member]); return RedisConnection.toLong(r, -1); }
        fn zRevRank(key: string, member: any) -> long { let r = self.command("ZREVRANK", [key, member]); return RedisConnection.toLong(r, -1); }
        fn zRange(key: string, start: long, stop: long) -> Array<string> { return RedisConnection.strings(self.command("ZRANGE", [key, start, stop]) as Array<any>); }
        fn zRevRange(key: string, start: long, stop: long) -> Array<string> { return RedisConnection.strings(self.command("ZREVRANGE", [key, start, stop]) as Array<any>); }
        fn zRangeByScore(key: string, min: double, max: double) -> Array<string> { return RedisConnection.strings(self.command("ZRANGEBYSCORE", [key, min, max]) as Array<any>); }
        fn zRemRangeByRank(key: string, start: long, stop: long) -> long { return RedisConnection.toLong(self.command("ZREMRANGEBYRANK", [key, start, stop]), 0); }
        fn zRemRangeByScore(key: string, min: double, max: double) -> long { return RedisConnection.toLong(self.command("ZREMRANGEBYSCORE", [key, min, max]), 0); }
        fn zPopMin(key: string) -> Array<string> { return RedisConnection.strings(self.command("ZPOPMIN", [key]) as Array<any>); }
        fn zPopMax(key: string) -> Array<string> { return RedisConnection.strings(self.command("ZPOPMAX", [key]) as Array<any>); }

        // Redis never puts a nil inside one of these replies (a collection's own
        // members, as opposed to a single value that can be "no such key").
        private static fn strings(r: Array<any>) -> Array<string> {
            let out = new Array<string>();
            for (x in r) { out.push("${x}"); }
            return out;
        }
        // An integer reply as it came (a long already), or a numeric one sent as
        // text (r[0] of a SCAN, say) parsed; `otherwise` for anything else.
        private static fn toLong(r: any, otherwise: long) -> long {
            if (r is long) { return r as long; }
            return r == null ? otherwise : Integer.parseOr("${r}", otherwise);
        }
        private static fn orNull(r: any) -> string? { return r == null ? null : "${r}"; }
        private static fn orEmpty(r: any) -> string { return r == null ? "" : "${r}"; }
    }

    // Commands queued by pipeline(): every reply comes back together, in order,
    // after one round trip (not read as each command is sent).
    class RedisPipeline {
        private conn: TcpStream
        // Every queued command, encoded as it goes (one write() of the whole
        // batch at flush(), not one per command).
        private buf: StringBuilder
        private n: int = 0
        constructor(conn: TcpStream) { self.conn = conn; self.buf = new StringBuilder(); }
        fn command(name: string, args: Array<any> = new Array<any>()) -> RedisPipeline {
            Resp.encodeCommand(self.buf, name, args);
            self.n += 1;
            return self;
        }
        // Sends every queued command in one write(), then reads every reply, in
        // order; a RedisError among them is thrown once all replies are read.
        fn flush() -> Array<any> {
            self.conn.write(self.buf.toString());
            let out = new Array<any>();
            out.reserve(self.n);
            let failure: RedisError = null;
            for (i in 0..self.n) {
                try { out.push(Resp.readReply(self.conn)); }
                catch (e: RedisError) { out.push(null); if (failure == null) { failure = e; } }
            }
            if (failure != null) { throw failure; }
            return out;
        }
    }

    // Commands queued by multi(): exec() runs them all atomically (null when a
    // watch()ed key changed first); discard() drops them instead.
    class RedisTransaction {
        private owner: RedisConnection
        private queued: int = 0
        constructor(owner: RedisConnection) { self.owner = owner; }
        fn command(name: string, args: Array<any> = new Array<any>()) -> RedisTransaction {
            self.owner.command(name, args);                     // answered "QUEUED"
            self.queued += 1;
            return self;
        }
        fn exec() -> Array<any> { return self.owner.command("EXEC") as Array<any>; }
        fn discard() { self.owner.command("DISCARD"); }
    }
}
